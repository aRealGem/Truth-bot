# Required
ANTHROPIC_API_KEY=sk-ant-...
BRAVE_API_KEY=BSA...

# LLM providers (add keys as available; adapters auto-enable when key is present)
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...
XAI_API_KEY=xai-...

# Optional — Bluesky publishing (v2)
BLUESKY_HANDLE=yourname.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Optional — Government data
FRED_API_KEY=...

# Optional — paths
TRUTHBOT_CACHE_DIR=./truthbot_cache
TRUTHBOT_REPORT_DIR=./reports
TRUTHBOT_METRICS_DIR=./metrics
TRUTHBOT_SITE_ROOT=/var/www/truthbot
TRUTHBOT_MAX_CLAIMS=30
# Public base URL of the published site, no trailing slash. Everything
# absolute derives from it: canonical, og:url, og:image, feed.xml entries and
# the reader-feedback prefill. Defaults to GitHub Pages; set this only when the
# site moves to a custom domain, and regenerate site-pca/ when you do.
# TRUTHBOT_SITE_URL=https://arealgem.github.io/Truth-bot/site-pca

# Optional — evidence prefetch / ingestion source (default: none)
# Prefer TRUTHBOT_EVIDENCE_SOURCE over legacy TRUTHBOT_PREFETCH_EVIDENCE.
# TRUTHBOT_EVIDENCE_SOURCE=none|connectors|datahoover
# TRUTHBOT_PREFETCH_EVIDENCE=1   # if EVIDENCE_SOURCE unset: truthy → connectors

# Optional — DataHoover stub (TruthBot returns [] until wired; owned by DataHoover project)
# TRUTHBOT_DATAHOOVER_URL=https://...
# TRUTHBOT_DATAHOOVER_MANIFEST=/path/to/manifest.ndjson

# Optional — triage tier model overrides (see verify/triage.py)
# TRUTHBOT_TRIAGE_ANTHROPIC_MODEL=claude-3-5-haiku-20241022
# TRUTHBOT_TRIAGE_OPENAI_MODEL=gpt-4o-mini
# TRUTHBOT_TRIAGE_GEMINI_MODEL=gemini-2.5-flash
# TRUTHBOT_TRIAGE_GROK_MODEL=grok-3-mini

# LiteLLM proxy (HydraMind L-P lane) truth-bot client virtual key + base URL.
# Provision: see eval/benchmarks/PROVISIONING.md ; legacy LITELLM_PCA_KEY/LITELLM_KEY also accepted.
LITELLM_TRUTHBOT_KEY=<value>
LITELLM_BASE_URL=http://127.0.0.1:4141
