# Required
ANTHROPIC_API_KEY=sk-ant-...
BRAVE_API_KEY=BSA...

# LLM providers (add keys as available; adapters auto-enable when key is present)
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...
XAI_API_KEY=xai-...

# Optional — Bluesky publishing (v2)
BLUESKY_HANDLE=yourname.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Optional — Government data
FRED_API_KEY=...

# Optional — paths
TRUTHBOT_CACHE_DIR=./truthbot_cache
TRUTHBOT_REPORT_DIR=./reports
TRUTHBOT_METRICS_DIR=./metrics
TRUTHBOT_SITE_ROOT=/var/www/truthbot
TRUTHBOT_MAX_CLAIMS=30
