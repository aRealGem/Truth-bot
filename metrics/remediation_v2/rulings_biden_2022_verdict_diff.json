  "per_sid": [
    {
      "sid": "biden_2022:0019",
      "old": "TRUE",
      "new": "gated-UNVERIFIABLE",
      "category": "newly_gated",
      "text": "In this struggle as President Zelenskyy said in his speech to the European Parliament “Light will win over darkness.” Th"
    },
    {
      "sid": "biden_2022:0100",
      "old": "TRUE",
      "new": "gated-UNVERIFIABLE",
      "category": "newly_gated",
      "text": "I remember when my dad had to leave our home in Scranton, Pennsylvania to find work."
    },
    {
      "sid": "biden_2022:0124",
      "old": "UNVERIFIABLE",
      "new": "gated-UNVERIFIABLE",
      "category": "newly_gated",
      "text": "America used to have the best roads, bridges, and airports on Earth."
    },
    {
      "sid": "biden_2022:0137",
      "old": "TRUE",
      "new": "gated-UNVERIFIABLE",
      "category": "newly_gated",
      "text": "And tonight, I’m announcing that this year we will start fixing over 65,000 miles of highway and 1,500 bridges in disrep"
    },
    {
      "sid": "biden_2022:0171",
      "old": "TRUE",
      "new": "gated-UNVERIFIABLE",
      "category": "newly_gated",
      "text": "As Ohio Senator Sherrod Brown says, “It’s time to bury the label “Rust Belt.” It’s time."
    },
    {
      "sid": "biden_2022:0211",
      "old": "MISLEADING",
      "new": "gated-UNVERIFIABLE",
      "category": "newly_gated",
      "text": "Look, the American Rescue Plan is helping millions of families on Affordable Care Act plans save $2,400 a year on their "
    },
    {
      "sid": "biden_2022:0284",
      "old": "TRUE",
      "new": "gated-UNVERIFIABLE",
      "category": "newly_gated",
      "text": "And Pfizer is working overtime to get us 1 million pills this month and more than double that next month."
    },
    {
      "sid": "biden_2022:0376",
      "old": "TRUE",
      "new": "gated-UNVERIFIABLE",
      "category": "newly_gated",
      "text": "The constitutional right affirmed in Roe v."
    },
    {
      "sid": "biden_2022:0420",
      "old": "TRUE",
      "new": "gated-UNVERIFIABLE",
      "category": "newly_gated",
      "text": "One of those soldiers was my son Major Beau Biden."
    },
    {
      "sid": "biden_2022:0427",
      "old": "TRUE",
      "new": "gated-UNVERIFIABLE",
      "category": "newly_gated",
      "text": "Combat medic in Kosovo and Iraq."
    },
    {
      "sid": "biden_2022:0431",
      "old": "TRUE",
      "new": "gated-UNVERIFIABLE",
      "category": "newly_gated",
      "text": "He loved building Legos with their daughter."
    }
  ]
}
